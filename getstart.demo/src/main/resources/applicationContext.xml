<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	   xmlns:context="http://www.springframework.org/schema/context"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans.xsd
           http://www.springframework.org/schema/context
           http://www.springframework.org/schema/context/spring-context.xsd">
           
  <context:component-scan base-package="com.in28minutes.getstart.getstart.demo"></context:component-scan>

  <bean id="xmlJdbcConnection" class="com.in28minutes.getstart.getstart.demo.xml.XmlJdbcConnection">
    <!-- collaborators and configuration for this bean go here -->
  </bean>

  <bean id="xmlPersonDAO" class="com.in28minutes.getstart.getstart.demo.xml.XmlPersonDAO">
  <property name="xmlJdbcConnection" ref="xmlJdbcConnection"></property>
    <!-- collaborators and configuration for this bean go here -->
  </bean>

  <!-- more bean definitions go here -->

</beans>